---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import Cards from "../components/Cards.astro";
import ExperienceTabs from "../components/ExperienceTabs.tsx";

import {
  cards,
  tecnologias,
  habilidadesBlandas,
  experiences,
} from "../content/data/db.ts";

// Aplana todas las sublistas en un solo array
const todasLasTec = Object.values(tecnologias).flat();
import SectionSkills from "../components/SectionSkills.astro";
import ContenedorTecnologia from "../components/ContenedorTecnologia.astro";

import { getCollection, type CollectionEntry } from "astro:content";

//Definimos el tipo de datos que representan los proyectos
type Project = CollectionEntry<"projects"> & { slug: string };

//Obtengamos los proyectos.
const proyectos: Project[] = (await getCollection("projects")) as Project[];

import Project from "../components/Project.astro";
---

<Layout>
  <div class="w-full h-full">
    <div
      class="flex flex-col md:flex-row text-center gap-10 md:gap-20 mt-10 p-6 justify-center items-center"
    >
      <div class="min-h-[60vh] flex flex-col text-left justify-center">
        <h4 class="text-teal-300 text-lg font-mono mb-2">Hola, mi nombre es</h4>
        <h1 class="text-5xl sm:text-6xl font-extrabold text-gray-100 mb-2">
          Elmer Sosa
        </h1>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-400 mb-6">
          Así que deseas saber sobre mí 👀
        </h2>
        <p class="max-w-xl text-gray-400 text-lg mb-8 text-left">
          🚀 Como <span class="text-blue-400 font-semibold"
            >estudiante de Ingeniería en Sistemas</span
          >, soy un
          <span class="text-green-400 font-semibold">
            apasionado del desarrollo</span
          > y la
          <span class="text-yellow-400 font-semibold">
            implementación de soluciones tecnológicas</span
          >
          que permiten a los negocios alcanzar el impacto que buscan.<br />
          💻 Me especializo en el <span class="text-purple-400 font-semibold"
            >desarrollo web full stack</span
          >, trabajando con tecnologías de vanguardia. Tengo una gran capacidad
          de aprendizaje 📚 para adaptarme a
          <span class="text-pink-400 font-semibold"> nuevas tecnologías</span> y
          desafíos.
        </p>
      </div>

      <Image
        src="/assets/elmer.jpg"
        alt="Elmer"
        width={300}
        height={300}
        class="rounded-lg shadow-lg border-2 border-gray-700 transition-all duration-300 hover:scale-105 hover:border-yellow-400"
      />
    </div>

    <a
      href="/CV - Elmer Noé Sosa.pdf"
      download="CV - Elmer Noé Sosa.pdf"
      class="ml-10 inline-flex items-center px-4 py-2 text-sm font-medium
         text-gray-900 bg-white border border-gray-200 rounded-lg
         hover:bg-gray-100 hover:text-blue-700 focus:ring-4 focus:ring-gray-100
         dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600
         dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
      aria-label="Descargar CV de Elmer Noé Sosa"
    >
      <!-- Ícono de Descarga -->
      <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path
          d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z"
        ></path>
        <path
          d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"
        ></path>
      </svg>
      Descargar CV
    </a>

    <section class="p-10">
      <h2 class="text-xl font-bold text-white mb-6 text-left ml-2">
        Del Aprendizaje a la Implementación
      </h2>

      <div class="grid md:grid-cols-2 gap-6">
        {
          cards
            .slice(1)
            .map((card) => (
              <Cards title={card.title} description={card.description} />
            ))
        }
      </div>
    </section>

    <section class="p-10">
      <h2 class="text-4xl font-bold text-white text-left ml-2 mb-4">
        Hábilidades
      </h2>
      <div class="grid md:grid-cols-3 gap-6">
        {
          habilidadesBlandas.map((habilidad) => (
            <Cards
              title={habilidad.title}
              description={habilidad.description}
            />
          ))
        }
      </div>
    </section>

    <!-- sección de experiencia -->
    <section id="experience" class="max-w-4xl mx-auto my-16 px-4">
      <h2 class="text-2xl font-bold mb-6">02. Experiencia</h2>
      <ExperienceTabs experiencesProps={experiences} client:load />
    </section>

    <!-- sección de proyectos -->
    <section class="p-10">
      <h2 class="text-4xl font-bold text-white text-left ml-2 mb-4">
        Proyectos
      </h2>
      <p class="text-lg text-left text-gray-300 mb-6 ml-2">
        Aquí puedes ver algunos de los proyectos en los que he trabajado, cada
        uno representando un paso en mi viaje de aprendizaje y desarrollo.
      </p>
      <div>
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-5xl mx-auto"
        >
          {
            proyectos.map((proyecto) => (
              <Project
                title={proyecto.data.title}
                urlImagen={proyecto.data.imagen}
                description={proyecto.data.description}
                href={`/projects/${proyecto.slug}`}
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- sección de tecnologías -->

    <div class="p-10">
      <h2 class="text-4xl font-bold text-white text-left ml-2 mb-4">
        Tecnologías
      </h2>
      <p class="text-lg text-left text-gray-300 mb-6 ml-2">
        A lo largo de mi trayectoria, he trabajado en <span
          class="text-blue-400 font-semibold">proyectos muy diversos</span
        >, lo que me ha llevado a desarrollar una gran
        <span class="text-green-400 font-semibold"
          >capacidad de aprendizaje autónomo</span
        >. Me apasiona explorar <span class="text-yellow-400 font-semibold"
          >nuevas tecnologías</span
        > y herramientas que permitan construir
        <span class="text-purple-400 font-semibold">soluciones completas</span>,
        desde la idea hasta su implementación.
      </p>

      <div class="grid grid-cols-1 gap-6 w-full max-w-5xl mx-auto">
        <ContenedorTecnologia tecnologias={todasLasTec} />
      </div>
    </div>
  </div>
</Layout>
