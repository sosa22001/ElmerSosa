---
import { Social, NavItems } from "../content/data/db";
import RedSocial from "./RedSocial.astro";
---

<nav
  class="relative z-40 dark:bg-gray-800 flex justify-between items-center px-6 py-2 border-b border-gray-700 shadow-lg md:ml-64 bg-gray-800 transition-all duration-300 w-full md:w-[calc(100%-16rem)] max-w-full overflow-hidden"
>
  <div class="flex items-center space-x-4">
    <h2 class="text-2xl font-bold text-white whitespace-nowrap">
      Elmer Noé Sosa
    </h2>
    <span class="text-gray-400 text-lg whitespace-nowrap"
      >🚀 Desarrollador Web Full Stack</span
    >
  </div>

  <!-- nav items  -->
  <ul class="flex space-x-8">
    {
      NavItems.map((item) => (
        <li class="flex items-center transition-transform duration-300 hover:scale-110 space-x-2">
          <p class="font-mono text-blue-400">
            {String(item.id).padStart(2, "0")}.
          </p>
          <a
            href={`#${item.id}`}
            class="text-gray-300 hover:text-white font-medium"
          >
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>

  <!-- Redes sociales -->
</nav>
